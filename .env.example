# Base Network Configuration
BASE_RPC_URL=https://mainnet.base.org

# Definitive Flash API Configuration
# Flash API Key from app.definitive.fi -> More -> Flash -> Create Flash Key
DEFINITIVE_API_KEY=

# Dynamic Wallet Configuration
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_KEY=

# Agent Signer Private Key (Optional dev fallback for local server signing)
# Generates or signs EIP-712 orders on behalf of the agent policy
AGENT_SIGNER_PRIVATE_KEY=

# Bankr LLM Gateway Configuration
# Key from bankr.bot/api-keys (OpenAI-compatible gateway: https://llm.bankr.bot/v1)
BANKR_API_KEY=

# Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server & Agent Configuration
PORT=3001
DEMO_MODE=true
POLL_INTERVAL_SECONDS=60
